[Unit]
Description=BioMax ADMS push listener (attendance device 502)
After=network.target

[Service]
Type=simple
User=saleshandy
WorkingDirectory=/home/saleshandy/biomax-adms
ExecStart=/usr/bin/python3 /home/saleshandy/biomax-adms/adms_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
