[Unit]
Description=BioMax attendance sync (pulls logs directly from devices, no SmartOffice dependency)
After=network.target

[Service]
Type=simple
User=saleshandy
WorkingDirectory=/home/saleshandy/biomax-sync
ExecStart=/usr/bin/python3 -u /home/saleshandy/biomax-sync/biomax_sync.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
